# Backend API origin (no trailing slash)
REACT_APP_API_URL=http://localhost:8000

# Store identity fallbacks (runtime StoreSettings overrides these at runtime).
REACT_APP_STORE_NAME=Store
REACT_APP_CURRENCY_SYMBOL=₹
REACT_APP_LOCALE=en-IN

# Default SEO (per-store runtime SEO is applied by SeoHead from StoreSettings).
REACT_APP_SEO_TITLE=Store
REACT_APP_SEO_DESCRIPTION=Premium online store
REACT_APP_SEO_OG_IMAGE=/logo.png
