# ============================================================================
# SERVER environment — secrets live ONLY here, never in client/.env.
# The client bundle exposes any REACT_APP_* var; keep DB/Cloudinary/JWT secrets
# out of the client entirely. Copy to server/.env and fill in. Never commit it.
# ============================================================================

# MongoDB Atlas connection string — MUST include the database name and use the
# mongodb+srv:// form. Each store points at its OWN database (DB-per-store model).
DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<store-db-name>?retryWrites=true&w=majority
PORT=8000

# DNS resolver override for the mongodb+srv SRV lookup. Defaults to public DNS
# (8.8.8.8,1.1.1.1) which fixes `querySrv ECONNREFUSED` on some Windows hosts.
# Set to "off" to use the OS resolver. Honored by the server and all scripts.
DNS_SERVERS=8.8.8.8,1.1.1.1

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Per-store Cloudinary asset namespace. NOTE: existing Aura Rare deployments
# MUST set this to "aura-rare" to keep continuity with already-uploaded assets.
CLOUDINARY_FOLDER=vce

# Bootstrap identity fallbacks (runtime StoreSettings overrides these)
STORE_NAME=
CURRENCY_SYMBOL=₹
LOCALE=en-IN

# Razorpay (optional online payments). key_id is public; secret/webhook secret
# are server-only. Enable the provider per store via StoreSettings.payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Auth — set a long random string in production
JWT_SECRET=

# Comma-separated allowed origins in production, e.g. https://aurarare.vercel.app
CORS_ORIGINS=

# Merchant notifications (optional): webhook POSTed on new orders and status
# changes — point it at Zapier/Make/Slack/Discord/your own endpoint.
NOTIFY_WEBHOOK_URL=

# ============================================================================
# VCE PANEL / PLATFORM (operator-only — the agency control plane, npm run panel).
# These are NOT part of a store's runtime config; they belong to whoever runs
# the panel. The panel reads them from this same server/.env via dotenv.
# ============================================================================

# Platform database — the agency's single source of truth (stores, operators,
# deployments, activity log). MUST include the `vce_platform` database name.
# Contains agency metadata ONLY — never products/orders/customers. If unset, the
# panel falls back to the fleet registry (provisioning/fleet.json).
PLATFORM_DATABASE=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vce_platform?retryWrites=true&w=majority

# Cluster root (NO database name) — used ONLY to reach each individual store's
# own database when the panel provisions/edits it.
PROVISION_CLUSTER_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Panel access key. If unset, one is generated and printed on startup.
PANEL_KEY=
# PANEL_PORT=8100
